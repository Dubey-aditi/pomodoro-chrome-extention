{
  "manifest_version": 3,
  "name": "Bloom Focus",
  "version": "1.0.0",
  "description": "A cozy focus & break timer with calm background music and a floating timer on coding practice sites.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bloom Focus",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "notifications", "offscreen"],
  "content_scripts": [
    {
      "matches": [
        "*://*.leetcode.com/*",
        "*://*.geeksforgeeks.org/*",
        "*://*.neetcode.io/*",
        "*://*.hellointerview.com/*"
      ],
      "js": ["widget.js"],
      "run_at": "document_idle"
    }
  ]
}
